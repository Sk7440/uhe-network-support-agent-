# Copy to .env and edit. Never commit .env.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=gemma4:31b-cloud
EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.1

# SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://uhe_agent:CHANGE_ME@localhost:5432/uhe_agent
DATABASE_URL=

# Long random string. Required to open the admin dashboard.
ADMIN_TOKEN=change-me-to-a-long-random-string

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# false = approved Level 2 changes are logged, and the user is guided to run them (safe default)
# true  = approved changes run on THIS machine (ipconfig /renew, /flushdns)
ALLOW_LEVEL2_EXECUTION=false

TOOL_TIMEOUT=15
